# Frontend Environment Variables (.env.local)

# Backend API URL (Render or Local)
VITE_PUBLIC_API_URL=http://localhost:5000/api

# Supabase Configuration
VITE_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Paystack Public Key (Safe for frontend)
VITE_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key
