# =================================================================
# PHOTIZO CONFERENCE BACKEND ENVIRONMENT VARIABLES
# =================================================================

PORT=5000
NODE_ENV=development

# Supabase Credentials (from Supabase Dashboard -> Project Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# Paystack API Keys (from Paystack Dashboard -> Settings -> API Keys & Webhooks)
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key
PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key

# Resend Email Delivery (from Resend Dashboard -> API Keys)
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=Photizo Conference <onboarding@resend.dev>

# Frontend Client URL
FRONTEND_URL=http://localhost:5173

# Conference Metadata
CONFERENCE_NAME=Photizo Conference 2026
CONFERENCE_DATES=May 21 - 23, 2026
CONFERENCE_VENUE=Higher Ground Baptist Church, Ogbomoso, Nigeria.
